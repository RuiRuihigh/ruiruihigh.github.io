---
import { LINKS } from "@consts";
---
<header class="site-header">
 <div class="nav-inner">
  <a class="wordmark" href="/" aria-label="Mingrui Liang home"><span class="monogram">ml</span><span>Mingrui Liang</span></a>
  <nav aria-label="Main navigation">{LINKS.map(link => <a href={link.HREF}>{link.TEXT}</a>)}</nav>
  <button class="theme-toggle" id="header-theme-button" aria-label="Switch color theme" title="Switch color theme"><span class="sun-icon" aria-hidden="true">☼</span><span class="moon-icon" aria-hidden="true">☾</span></button>
 </div>
</header>
