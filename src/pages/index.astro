---
import PageLayout from "@layouts/PageLayout.astro";
import PublicationList from "@components/PublicationList.astro";
import { SITE } from "@consts";
import { profile, projects, education, experience } from "../data/profile";
---
<PageLayout title="Home" description={SITE.DESCRIPTION}>
 <section class="hero" aria-labelledby="hero-name">
  <div class="star-field" aria-hidden="true"><div id="stars1"></div><div id="stars2"></div><div id="stars3"></div></div>
  <div class="sphere-horizon" aria-hidden="true"></div>
  <div class="hero-inner shell">
   <div class="hero-copy">
    <p class="eyebrow">Speech · Language Model · Machine Learning</p>
    <h1 id="hero-name">Mingrui<br/><span>Liang</span></h1>
    <p class="hero-description">Understanding speech<br class="desktop-break"/> beyond the words.</p>
    <p class="hero-detail">I work on speech generation, audio-language understanding, and reliable audio deepfake detection.</p>
    <div class="hero-actions"><a class="button primary" href="#publications">Explore my research <span aria-hidden="true">↘</span></a><a class="button secondary" href={profile.cvUrl}>View CV</a></div>
    <div class="social-links"><a href={profile.scholar}>Google Scholar ↗</a><a href={profile.github}>GitHub ↗</a><a href={`mailto:${profile.email}`}>Email ↗</a></div>
   </div>
   <figure class="portrait"><img src="/portrait.jpg" width="734" height="1025" alt="Mingrui Liang at Revere Beach at sunset" fetchpriority="high"/><figcaption><span>Mingrui Liang</span><span>Revere Beach, MA</span></figcaption></figure>
  </div>
  <div class="hero-bottom shell"><span>Speech generation / Understanding / Trust</span><a href="#about">Scroll to discover ↓</a></div>
 </section>
 <section class="section shell about-section" id="about" aria-labelledby="about-title">
  <div class="section-aside"><p class="eyebrow">01 / About</p><h2 id="about-title">Listening to<br/>the whole story.</h2></div>
  <div class="about-copy">
   <p class="lead">My research connects expressive speech generation with audio-language understanding and trustworthy speech systems.</p>
   <p>I received my M.S. in Electrical and Computer Engineering from Johns Hopkins University, where I worked with Najim Dehak and Jesús Villalba on spoken dialogue understanding and audio deepfake detection. I previously studied Computer Science and Engineering at The Chinese University of Hong Kong, Shenzhen, and worked with Zhizheng Wu on singing voice conversion.</p>
   <p>Since June 2026, I have been working with Shinji Watanabe at Carnegie Mellon University on multi-speaker text-to-speech synthesis.</p>
   <div class="interest-tags"><span>Speech synthesis</span><span>Audio-language models</span><span>Emotion & prosody</span><span>Audio deepfake detection</span></div>
  </div>
 </section>
 <section class="section shell" id="publications" aria-labelledby="publications-title">
  <div class="section-heading"><div><p class="eyebrow">02 / Publications</p><h2 id="publications-title">Research in focus.</h2></div><a class="text-link" href={profile.scholar}>Google Scholar ↗</a></div>
  <PublicationList/>
 </section>
 <section class="section shell" id="projects" aria-labelledby="projects-title">
  <div class="section-heading"><div><p class="eyebrow">03 / Selected projects</p><h2 id="projects-title">From models to sound.</h2></div></div>
  <div class="project-grid">{projects.map((project, i) => <article class="project-card">
   <div class="project-top"><span class="project-number">0{i+1}</span><span>{project.period}</span></div>
   <h3>{project.title}</h3><p class="project-institution">{project.institution}<br/><span>With {project.supervisor}</span></p><p>{project.text}</p>
   <div class="project-result">{project.result}</div>
   <div class="project-tags">{project.tags.map(tag => <span>{tag}</span>)}</div>
   <a class="text-link" href={project.url}>{project.linkLabel} ↗</a>
  </article>)}</div>
 </section>
 <section class="section shell" id="experience" aria-labelledby="experience-title">
  <div class="section-heading"><div><p class="eyebrow">04 / Background</p><h2 id="experience-title">Learning. Building. Sharing.</h2></div><a class="text-link" href={profile.cvUrl}>Full CV ↗</a></div>
  <div class="background-grid"><div><h3 class="column-heading">Education</h3><div class="timeline">{education.map(item => <article class="timeline-item"><p class="date">{item.date} <span>{item.place}</span></p><h4>{item.school}</h4><p>{item.degree}</p><p class="muted">{item.detail}</p></article>)}</div></div>
  <div><h3 class="column-heading">Industry & teaching</h3><div class="timeline">{experience.map(item => <article class="timeline-item"><p class="date">{item.date}</p><h4>{item.company}</h4><p class="role">{item.role}</p><p class="muted">{item.text}</p></article>)}</div></div></div>
 </section>
 <section class="contact-section" id="contact"><div class="shell contact-inner"><div><p class="eyebrow">Get in touch</p><h2>Let’s talk speech.</h2><p>I welcome conversations about speech research and collaboration.</p></div><a class="contact-email" href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a></div></section>
</PageLayout>
<script is:inline src="/js/bg.js"></script>
